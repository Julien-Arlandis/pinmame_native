                        fs.writeFileSync(romPath, Buffer.from(data, 'base64'));
                        info(`  ROM sauvegardÃ©e â†’ ${romPath}`);
                    }
                    currentRomArgs = currentRomArgs.filter(a => !a.startsWith('--rom=') && !a.startsWith('--custom-rom='));
